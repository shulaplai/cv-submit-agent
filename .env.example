# ================= CV SUBMIT AGENT =================
# Copy this file to .env and fill in your values.
# .env is gitignored — your secrets stay local.

# --- LLM (DeepSeek primary) ---
# Get a key at https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- LLM fallback (Qwen via DashScope, optional) ---
# Get a key at https://bailian.console.aliyun.com
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-plus

# --- Applicant (used for email applications + CL signature) ---
APPLICANT_NAME=
APPLICANT_EMAIL=

# --- CV PDFs (absolute paths) ---
# gov.hk 中文 JD 會用 CV_ZH_PATH；英文 JD 用 CV_EN_PATH
CV_EN_PATH=
CV_ZH_PATH=

# --- Job targeting ---
# Comma-separated keywords used by JobsDB search + title filtering
JOB_KEYWORDS=AI Engineer,agent developer,AI developer,developer,programmer,frontend developer,資訊科技工程師,AI 工程師,AI基礎架構
# 0-100; jobs scoring below this are hidden from the main board by default
MATCH_THRESHOLD=50
# Scheduled scan: every SCAN_DAY_INTERVAL days at SCAN_HOUR (0 disables).
# Default: every 2 days at 23:00 (夜晚 11 點)
SCAN_HOUR=23
SCAN_DAY_INTERVAL=2
# LLM budget per scan: only the top-N new jobs get full LLM match + CL;
# the rest are left for backfill (Dashboard「補齊」button) or manual refresh.
MAX_ENRICH_PER_SCAN=30
# 只保留刊登日期喺兩個月（60日）之內嘅新工（gov.hk 資訊及科技界都用呢個，
# DD/MM/YYYY 刊登日期會對照 scan 嗰日）；無刊登日期嘅（如 OfferToday）照保留。
# gov.hk 列表係「由近至遠」排，一掃到過期工就即刻停成個渠道，慳時間。設 0 就唔過濾。
MAX_JOB_AGE_DAYS=60
# gov.hk 大灣區青年就業計劃：刊登日期要喺一個月（30日）之內。
GBAY_MAX_JOB_AGE_DAYS=30
# gov.hk 資訊及科技界：每次 scan 最多取頭幾多份（list 由新到舊）。
GOVHK_IT_MAX_JOBS=50
# 可選：全部平台合計嘅總上限（跨平台平均分配）。0 = 冇總上限，淨係用各渠道自己嘅上限。
MAX_SCAN_JOBS=0
# OfferToday 每個搜索結果（資訊科技/工程師/科技 三個分類）每次 scan 最多取頭幾多份。
OFFERTODAY_MAX_PER_SEARCH=40
# Weekly application target shown on the Dashboard (X / GOAL)
GOAL_APPLICATIONS_PER_WEEK=15
# Set false to stop scraping jobs.gov.hk (大灣區計劃 + 資訊及科技界)
GOVHK_ENABLED=true
# JobsDB is hidden for now; set true to re-enable JobsDB scraping + show its jobs
JOBSDB_ENABLED=false

# --- Application behavior ---
# true = 自動投遞：填 CL + 上傳 CV 後直接提交 / 自動發 email（唔停低等你）。
# false = 半自動：預填後等你喺瀏覽器/郵件自己撳。
# 設定頁都可以改（會覆蓋呢度）。
AUTO_SUBMIT=true

# --- GBA scheme eligibility (shown as a warning in the UI) ---
GBA_AGE_UNDER_29=true
GBA_EDU_ASSOCIATE_DEGREE=true
